{
  "name": "gabayan-admin-functions",
  "description": "Cloud Functions for the GaBayan admin panel (firebase.json codebase \"admin\")",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "check": "node --check index.js && find src -name '*.js' -exec node --check {} \\;",
    "serve": "firebase emulators:start --only functions,firestore,auth",
    "deploy": "firebase deploy --only functions:admin",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0"
  }
}
