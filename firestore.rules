rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admin/$(request.auth.uid));
    }

    // ADMIN COLLECTION (Web Portal)
    match /admin/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // MASTER SERVICES (Controlled via the Web Portal)
    match /offices/{officeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      match /services/{serviceId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }
    }

    // USERS COLLECTION (Auth & Password Reset)
    match /users/{userId} {
      // Owner or admin can read/write their profile
      allow read, write: if isSignedIn() && (isAdmin() || request.auth.uid == userId);

      // Unauthenticated users can query to see if an email exists (Checking Email)
      allow list: if !isSignedIn();

      // Custom Password Reset Verification (Changing Password)
      allow update: if !isSignedIn()
                    && request.resource.data.recoveryCode ==
                       get(/databases/$(database)/documents/recovery_codes/$(resource.data.email)).data.code
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['password', 'recoveryCode']);

      // CITIZEN SERVICE HISTORY (Controlled via the Flutter App)
      match /service_history/{historyId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      // CHATBOT CONVERSATIONS
      match /conversations/{convoId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;

        match /messages/{messageId} {
          allow read, write: if isSignedIn() && request.auth.uid == userId;
        }
      }
    }

    // RECOVERY CODES COLLECTION
    match /recovery_codes/{email} {
      allow write: if !isSignedIn();
      allow get: if !isSignedIn();
      allow list: if false; // block hackers from downloading the entire collection
    }
  }
}